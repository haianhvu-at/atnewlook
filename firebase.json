{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "README.md",
      "**/.*",
      "**/node_modules/**",
      "**/desktop.ini",
      "_partials/**"
    ],
    "headers": [
      {
        "source": "**/*.@(css|js|webp|jpg|png|svg|mp4|webm)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/petit-groupe/circuit-vietnam-petit-groupe",
        "destination": "/voyage-au-vietnam/?type=groupe",
        "type": 301
      },
      {
        "source": "/petit-groupe/circuit-vietnam-petit-groupe/**",
        "destination": "/voyage-au-vietnam/?type=groupe",
        "type": 301
      }
    ]
  }
}
